{
    // editor & autoformatter settings
    "editor.bracketPairColorization.enabled": true,
    "editor.formatOnSave": true,
    "editor.guides.bracketPairs": "active",
    "editor.trimAutoWhitespace": true,
    "files.trimTrailingWhitespace": true,
    "prettier.enable": true,

    // python - other
    "python.languageServer": "Pylance",

    // python - linting & static analysis
    "python.analysis.extraPaths": ["{{ cookiecutter.package_name }}"],
    "python.analysis.typeCheckingMode": "off",

    // Python files only (Ruff handles formatting, import sorting & lint fixes)
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.formatOnPaste": false,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },

    // python - pytest (https://code.visualstudio.com/docs/python/testing)
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests"],

    // git
    "git.enabled": true,

    // file associations
    "files.associations": {
        "**/*.html": "html",
        "**/*.js": "javascript",
        "**/requirements{/**,*}.{txt,in}": "pip-requirements"
    },

    // markdownlint
    "markdownlint.run": "onSave",
    "markdownlint.ignore": [],
    "markdownlint.config": {
        // MD003 - Heading style
        "MD003": {
            "style": "atx"
        },
        // MD007 - Unordered list indentation
        "MD007": {
            "start_indented": true,
            "indent": 2
        },
        // MD012 - Multiple consecutive blank lines
        "MD012": false,
        // MD022 - Headings should be surrounded by blank lines
        "MD022": false,
        // MD024 - Multiple headings with the same content
        "MD024": false,
        // MD032 - Lists should be surrounded by blank lines
        "MD032": false,
        // MD046 - Code block style
        "MD046": {
            "style": "fenced"
        },
        "no-hard-tabs": true
    },
}
